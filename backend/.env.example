# Copy to .env for local development (`cp .env.example .env`). .env is git-ignored.
# All values below are non-secret placeholders. Generate real secrets yourself,
# for example: openssl rand -base64 48

NODE_ENV=development
PORT=3000

# Database: set DATABASE_URL, OR all of the DB_* parts below (DATABASE_URL wins).
DATABASE_URL=postgresql://simple_invoice:change-me@localhost:5432/simple_invoice
# DB_HOST=localhost
# DB_PORT=5432
# DB_USER=simple_invoice
# DB_PASSWORD=change-me
# DB_PASSWORD_FILE=/run/secrets/db_password   # alternative to DB_PASSWORD
# DB_NAME=simple_invoice

# JWT signing secret, at least 32 bytes. Set JWT_SECRET or JWT_SECRET_FILE, not both.
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-bytes
# JWT_SECRET_FILE=/run/secrets/jwt_secret
# Access token lifetime in seconds (60 to 86400). Assessment default is 3600; 900 is tighter.
JWT_ACCESS_TTL_SECONDS=3600
JWT_ISSUER=simple-invoice-api
JWT_AUDIENCE=simple-invoice-web

# Refresh token: idle lifetime, absolute session lifetime, cookie path and name.
REFRESH_TOKEN_TTL_SECONDS=86400
REFRESH_FAMILY_TTL_SECONDS=604800
REFRESH_COOKIE_PATH=/api/auth
# Use __Secure-si_rt behind HTTPS.
REFRESH_COOKIE_NAME=si_rt
# Browsers treat http://localhost as a secure context, so true works locally.
COOKIE_SECURE=true

# Origin check for the cookie endpoints (comma separated).
ALLOWED_ORIGINS=http://localhost:8080,http://localhost:5173
# CORS is disabled when empty (same-origin deployment). Comma separated origins otherwise.
CORS_ORIGINS=

BCRYPT_COST=12
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCKOUT_MAX_SECONDS=900

# Per minute, per client IP.
THROTTLE_LOGIN_LIMIT=10
THROTTLE_REFRESH_LIMIT=30
THROTTLE_GLOBAL_LIMIT=120

IDEMPOTENCY_TTL_SECONDS=86400
# IANA time zone that defines "today" for overdue logic.
BUSINESS_TIMEZONE=UTC
SWAGGER_ENABLED=true
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Demo user password used by `npm run seed` (at least 15 characters).
SEED_DEMO_PASSWORD=replace-with-a-demo-password
# Run the idempotent seed when the container starts.
SEED_ON_START=false
# Set true once to reset the demo passwords and clear lockouts on existing users.
SEED_RESET_PASSWORDS=false

# ---- docker compose only (docker-compose.yml reads these from the host env or .env) ----
# Secrets (owner and runtime DB passwords, JWT secret) are generated by the secrets-init service,
# never set here. The backend connects as the least-privilege role simple_invoice_app; the one-shot
# migrate service creates it from APP_DB_USER and APP_DB_PASSWORD_FILE, which compose sets itself.
# Leave APP_DB_USER, APP_DB_PASSWORD and APP_DB_PASSWORD_FILE unset for local dev (one DB user).
# Public demo password for the seeded users; compose falls back to a documented demo value.
# SEED_DEMO_PASSWORD is defined above and is reused by compose.
# Host ports, always bound to 127.0.0.1. Change them when a port is already taken.
# FRONTEND_HOST_PORT=8080
# The API has no host port by default (nginx is the only way in).
# Only used with docker/compose.api-port.yml.
# BACKEND_HOST_PORT=3000
# Only used with docker/compose.db-port.yml.
# DB_HOST_PORT=5432
# Folder that holds the web repo (must contain its Dockerfile).
# WEB_CONTEXT=../simple-invoice-web

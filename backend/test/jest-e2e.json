{
  "moduleFileExtensions": [
    "js",
    "json",
    "ts"
  ],
  "rootDir": "..",
  "roots": [
    "<rootDir>/test"
  ],
  "testRegex": ".*\\.e2e-spec\\.ts$",
  "transform": {
    "^.+\\.(t|j)s$": [
      "ts-jest",
      {
        "diagnostics": {
          "ignoreCodes": [
            151002
          ]
        }
      }
    ]
  },
  "testEnvironment": "node",
  "testTimeout": 120000,
  "maxWorkers": 1
}

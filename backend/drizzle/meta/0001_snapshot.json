      "checkConstraints": {
        "invoices_currency_check": {
          "name": "invoices_currency_check",
          "value": "\"invoices\".\"currency\" ~ '^[A-Z]{3}$'"
        },
        "invoices_status_check": {
          "name": "invoices_status_check",
          "value": "\"invoices\".\"status\" IN ('Draft', 'Pending', 'Paid')"
        },
        "invoices_tax_rate_check": {
          "name": "invoices_tax_rate_check",
          "value": "\"invoices\".\"tax_rate\" >= 0 AND \"invoices\".\"tax_rate\" <= 100"
        },
        "invoices_invoice_sub_total_check": {
          "name": "invoices_invoice_sub_total_check",
          "value": "\"invoices\".\"invoice_sub_total\" >= 0"
        },
        "invoices_total_tax_check": {
          "name": "invoices_total_tax_check",
          "value": "\"invoices\".\"total_tax\" >= 0"
        },
        "invoices_total_discount_check": {
          "name": "invoices_total_discount_check",
          "value": "\"invoices\".\"total_discount\" >= 0"
        },
        "invoices_total_amount_check": {
          "name": "invoices_total_amount_check",
          "value": "\"invoices\".\"total_amount\" >= 0"
        },
        "invoices_total_paid_check": {
          "name": "invoices_total_paid_check",
          "value": "\"invoices\".\"total_paid\" >= 0"
        },
        "invoices_due_after_invoice": {
          "name": "invoices_due_after_invoice",
          "value": "\"invoices\".\"due_date\" >= \"invoices\".\"invoice_date\""
        },
        "invoices_discount_le_sub": {
          "name": "invoices_discount_le_sub",
          "value": "\"invoices\".\"total_discount\" <= \"invoices\".\"invoice_sub_total\""
        },
        "invoices_total_formula": {
          "name": "invoices_total_formula",
          "value": "\"invoices\".\"total_amount\" = \"invoices\".\"invoice_sub_total\" + \"invoices\".\"total_tax\" - \"invoices\".\"total_discount\""
        },
        "invoices_balance_formula": {
          "name": "invoices_balance_formula",
          "value": "\"invoices\".\"balance_amount\" = \"invoices\".\"total_amount\" - \"invoices\".\"total_paid\""
        },
        "invoices_no_overpayment": {
          "name": "invoices_no_overpayment",
          "value": "\"invoices\".\"total_paid\" <= \"invoices\".\"total_amount\""
        },
        "invoices_paid_is_settled": {
          "name": "invoices_paid_is_settled",
          "value": "\"invoices\".\"status\" <> 'Paid' OR \"invoices\".\"balance_amount\" = 0"
        },
        "invoices_draft_is_unpaid": {
          "name": "invoices_draft_is_unpaid",
          "value": "\"invoices\".\"status\" <> 'Draft' OR \"invoices\".\"total_paid\" = 0"
        }
      },
